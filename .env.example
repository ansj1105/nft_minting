# Runtime
PORT=8088
NODE_ENV=development
MINTER_API_KEY=replace-with-shared-api-key

# Network selection: polygon-amoy, polygon-mainnet, ethereum-sepolia, ethereum-mainnet.
# Ethereum entries are inactive until a chain-specific ERC-1155 contract address and
# CONTRACT_DEPLOYMENT_BLOCK are supplied through runtime configuration.
NETWORK_ENV=polygon-amoy
NETWORK_CONFIG_PATH=config/networks.json

# Signing key. Never commit a real key. Use runtime secret storage in production.
MINTER_PRIVATE_KEY=replace-with-private-key
# Public address derived from MINTER_PRIVATE_KEY. Must also be used by Foxya deposit intents.
CUSTODY_ADDRESS=0x0000000000000000000000000000000000000000

# Optional overrides. Leave empty to use config/networks.json.
RPC_URL=
CHAIN_ID=
CONTRACT_ADDRESS=
